# URL pública del sitio (sin barra final). Obligatoria en producción.
NEXT_PUBLIC_SITE_URL=https://www.ejemplo.es

# Google Analytics 4 (opcional). Ej: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console: valor del meta de verificación (opcional)
NEXT_PUBLIC_GSC_VERIFICATION=

# Google AdSense (opcional). Ej: ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_CLIENT=

# Muestra huecos de anuncio marcados en desarrollo aunque no haya AdSense (true/false)
NEXT_PUBLIC_SHOW_AD_PLACEHOLDERS=false
